{
  "manifest_version": 3,
  "name": "Scout'n'Jobs filler",
  "version": "1.1.0",
  "description": "Fills your approved Scout'n'Jobs applications in your own browser, every morning. You do the CAPTCHA and press Submit.",
  "permissions": ["storage", "scripting", "webNavigation", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://scoutnjobs.vercel.app/*", "http://localhost:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://grnh.se/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["filler.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
